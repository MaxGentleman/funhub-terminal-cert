# The only value the browser needs. Safe to ship in the bundle: it is a public
# URL, and every cert table is unreachable through the REST API by design.
VITE_SUPABASE_URL=https://lbmcstlfubkyooeqkhce.supabase.co

# Server-side only. Set these as Supabase Edge Function secrets, never here.
#   SUPABASE_SERVICE_ROLE_KEY                  (injected by Supabase)
#   SUPABASE_DB_URL                            (injected by Supabase)
#   CERT_SESSION_SECRET          random 32+ chars, signs the session token
#   CERT_SYNC_SECRET             random 32+ chars, lets a schedule run drive-sync
#   GOOGLE_SERVICE_ACCOUNT_TERMINAL_CERT_JSON  the whole service-account key file, one line
#   CERT_ALLOWED_ORIGINS         comma-separated, e.g. https://terminals.funhub.ca
